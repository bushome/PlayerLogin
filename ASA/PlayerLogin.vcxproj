<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\PlayerLogin.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\Database.h" />
    <ClInclude Include="src\Discord.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="vcpkg.json" />
    <None Include="configs\config.json" />
    <None Include="configs\config.commented.json" />
    <None Include="configs\PluginInfo.json" />
    <None Include="sql\schema.sql" />
    <None Include="README.md" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{599AD8CA-35C2-4206-987F-D996B92B122B}</ProjectGuid>
    <RootNamespace>PlayerLogin</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>PlayerLogin</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(SolutionDir)out\</OutDir>
    <IntDir>$(OutDir)$(Platform)\</IntDir>
  </PropertyGroup>
  <!-- vcpkg manifest mode (vcpkg.json): static libs + dynamic CRT = x64-windows-static-md, so
       libmariadb links into PlayerLogin.dll and nothing extra ships with the plugin. -->
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <VcpkgUseMD>true</VcpkgUseMD>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <!-- UNICODE/_UNICODE come from CharacterSet=Unicode. Don't add WIN32_LEAN_AND_MEAN: AsaApi's Base.h defines it. -->
      <PreprocessorDefinitions>PROJECT_NAME="$(ProjectName)";NDEBUG;_WINDOWS;_USRDLL;NOMINMAX;_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;_SILENCE_ALL_CXX20_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /bigobj %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(SolutionDir)extern\AsaApi\AsaApi\Core\Public\;$(SolutionDir)extern\AsaApi\AsaApi\Core\Public\API\UE\;$(ProjectDir)src\</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <!-- libmariadb (static) needs ws2_32, secur32, crypt32, shlwapi and bcrypt; vcpkg links libmariadb itself. -->
      <AdditionalDependencies>$(SolutionDir)extern\AsaApi\out_lib\AsaApi.lib;ws2_32.lib;secur32.lib;crypt32.lib;shlwapi.lib;bcrypt.lib;$(CoreLibraryDependencies);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PreBuildEvent>
      <Command>if exist "$(TargetDir)$(TargetFileName).arkapi" del /q "$(TargetDir)$(TargetFileName).arkapi"</Command>
    </PreBuildEvent>
    <PostBuildEvent>
      <Command>copy /y "$(TargetDir)$(TargetFileName)" "$(TargetDir)$(TargetFileName).arkapi"
if not exist "$(TargetDir)PlayerLogin" mkdir "$(TargetDir)PlayerLogin"
copy /y "$(TargetDir)$(TargetFileName)" "$(TargetDir)PlayerLogin\"
copy /y "$(TargetDir)$(TargetName).pdb" "$(TargetDir)PlayerLogin\"
copy /y "$(ProjectDir)configs\PluginInfo.json" "$(TargetDir)PlayerLogin\"
copy /y "$(ProjectDir)configs\config.json" "$(TargetDir)PlayerLogin\"
copy /y "$(ProjectDir)configs\config.commented.json" "$(TargetDir)PlayerLogin\"</Command>
      <Message>Assembling out\PlayerLogin\ plugin folder</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Fail early with a readable message if the AsaApi submodule or its lib is missing. -->
  <Target Name="CheckAsaApi" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(SolutionDir)extern\AsaApi\AsaApi\Core\Public\API\ARK\Ark.h')" Text="AsaApi headers not found. Run: git submodule update --init --recursive" />
    <Error Condition="!Exists('$(SolutionDir)extern\AsaApi\out_lib\AsaApi.lib')" Text="AsaApi.lib not found in extern\AsaApi\out_lib. Build extern\AsaApi\AsaApi.sln (Release, x64), or copy AsaApi.lib from the Lib folder of the AsaApi release zip." />
  </Target>
</Project>
